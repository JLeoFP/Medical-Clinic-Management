{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: preparar",
      "program": "${workspaceFolder}/backend/src/Clinica.Api/bin/Debug/net10.0/Clinica.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Clinica.Api",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5071"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Angular (Edge)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "frontend: ng serve",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "API + Angular",
      "configurations": ["API (.NET)", "Angular (Edge)"],
      "stopAll": true
    }
  ]
}
