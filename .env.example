# Copie para .env e ajuste. O .env nunca é versionado.
# Papel dono do banco (usado pelas migrations)
POSTGRES_PASSWORD=troque-esta-senha-do-dono
# Senha do login restrito da API (clinica_api)
CLINICA_APP_SENHA=troque-esta-senha-da-api
# Execução fora do Docker (VS Code, F5 "API + Angular"): conexão da API com o papel restrito, host localhost.
# Use a mesma senha de CLINICA_APP_SENHA.
ConnectionStrings__Clinica=Host=localhost;Database=clinica;Username=clinica_api;Password=troque-esta-senha-da-api
# Administrador inicial (troca de senha obrigatória no primeiro acesso)
ADMIN_EMAIL=admin@clinica.local
ADMIN_SENHA_INICIAL=Troque123
# Opcional: chave de licença do MediatR 14
MEDIATR_LICENSE_KEY=
# Opcional: chaves de APIs externas (em dev fora do Docker use `dotnet user-secrets`, ver backend/README.md)
NEWRELIC_API_KEY=
LUCKYPENNY_API_KEY=
