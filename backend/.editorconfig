root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true

# "Shared" é o nome de namespace definido no TDD §7.2 (Domain/Shared).
dotnet_diagnostic.CA1716.severity = none
# Aplicação interna: sem exigência de ConfigureAwait, globalização por cultura ou validação de argumentos públicos.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1062.severity = none
# Convenção do projeto: CancellationToken se chama "ct"; log de duração calculado de forma barata.
dotnet_diagnostic.CA1725.severity = none
dotnet_diagnostic.CA1873.severity = none

[tests/**.cs]
# Nomes de teste em português com sublinhados descrevem o cenário.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1861.severity = none

[**/Migrations/*.cs]
generated_code = true
